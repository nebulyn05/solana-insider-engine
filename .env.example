# Application
APP_ENV=production
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solana_insider_sim

# Solana MAINNET ONLY
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet.solana.com
SOLANA_WS_URL=wss://api.mainnet.solana.com

# Data providers
HELIUS_API_KEY=
HELIUS_GRPC_ENDPOINT=https://laserstream-mainnet-ewr.helius-rpc.com
SHYFT_API_KEY=
SOLANA_TRACKER_API_KEY=

# Execution safety: mainnet observation + paper trading only
PAPER_TRADING=true
LIVE_EXECUTION=false
